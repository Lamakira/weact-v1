APP_NAME=WEACT
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
ASSET_URL=http://localhost:8000
# Comma-separated proxy IPs/CIDRs (e.g. the load balancer). NEVER use "*" in production:
# it trusts X-Forwarded-For from any client, letting attackers spoof their IP and bypass IP throttling.
TRUSTED_PROXIES=
REGISTRATION_ENABLED=true

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR
# Fuseau métier pour le bucketing des mois (le stockage reste en UTC)
APP_BUSINESS_TIMEZONE=Africa/Porto-Novo

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=weact
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost
# MUST be true in production (HTTPS) — session cookies then only travel over TLS.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Reverb (WebSocket broadcasting)
REVERB_APP_ID=weact-local
REVERB_APP_KEY=weact-key-local
REVERB_APP_SECRET=weact-secret-local
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

CACHE_STORE=database
# CACHE_PREFIX=

# Sanctum SPA Authentication
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:3000,127.0.0.1:5173

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# Google Sign-In (laravel/socialite).
# GOOGLE_REDIRECT_URI must match the Google console entry VERBATIM: no wildcards,
# and non-HTTPS is refused everywhere except http://localhost. One console entry
# per environment (dev / staging / prod).
# Leave GOOGLE_OAUTH_ENABLED=false until the credentials are in place: the
# endpoints answer 403 and the SPA hides the button.
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# En prod, passer MAIL_MAILER=smtp + remplir MAIL_HOST/MAIL_USERNAME/MAIL_PASSWORD.
# Procédure complète : docs/runbook-email-notifications.md.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
ADMIN_EMAIL="${MAIL_FROM_ADDRESS}"
# Destinataires des alertes e-mail sur logs critiques (séparés par des virgules ; vide = désactivé).
ADMIN_ALERT_EMAILS=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Fedapay (Mobile Money Payments)
FEDAPAY_SECRET_KEY=
FEDAPAY_PUBLIC_KEY=
FEDAPAY_ENVIRONMENT=sandbox
FEDAPAY_WEBHOOK_SECRET=
WITHDRAWAL_MODE=manual

# Web push (VAPID) - generate with: php artisan webpush:vapid --show
# Without keys push is silently disabled. See docs/runbook-web-push.md
VAPID_SUBJECT=mailto:contact@weact.bj
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
