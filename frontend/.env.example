# API Configuration
VITE_API_URL=http://localhost:8000/api/v1
VITE_BACKEND_URL=http://localhost:8000
VITE_APP_NAME=WEACT

# Feature Flags (for future use)
VITE_ENABLE_WALLET=false
# Fallback build-time si GET /auth/registration-status échoue (réseau/5xx).
# La valeur backend REGISTRATION_ENABLED reste la source de vérité quand l'API répond.
VITE_REGISTRATION_ENABLED=true

# Laravel Reverb (WebSocket chat)
VITE_REVERB_APP_KEY=weact-key-local
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

