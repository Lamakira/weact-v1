# ============================================
# WEACT Environment Configuration
# ============================================
# This file documents all required environment variables for the WEACT platform.
#
# IMPORTANT: This is a documentation file only!
# Actual environment variables should be configured in:
#   - /backend/.env (Laravel configuration)
#   - /frontend/.env (Vite configuration)
#
# Copy this file as reference and configure the respective .env files.
# ============================================

# --------------------------------------------
# DATABASE CONFIGURATION
# --------------------------------------------
# Configure these in: backend/.env

# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=weact
# DB_USERNAME=root
# DB_PASSWORD=

# --------------------------------------------
# LARAVEL CONFIGURATION
# --------------------------------------------
# Configure these in: backend/.env

# APP_NAME=WEACT
# APP_ENV=local
# APP_DEBUG=true
# APP_URL=http://localhost:8000

# SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:3000,127.0.0.1:5173
# SESSION_DOMAIN=localhost

# --------------------------------------------
# FRONTEND CONFIGURATION
# --------------------------------------------
# Configure these in: frontend/.env
# Note: All frontend env vars must be prefixed with VITE_

# VITE_API_BASE_URL=http://localhost:8000/api/v1
# VITE_APP_NAME=WEACT
# VITE_ENABLE_WALLET=false

# --------------------------------------------
# DEVELOPMENT PORTS
# --------------------------------------------
# Backend (Laravel): http://localhost:8000
# Frontend (Vue/Vite): http://localhost:5173

# --------------------------------------------
# QUICK START
# --------------------------------------------
# 1. Copy backend/.env.example to backend/.env
# 2. Copy frontend/.env.example to frontend/.env
# 3. Configure database credentials in backend/.env
# 4. Run: npm run install:all
# 5. Run: cd backend && php artisan migrate
# 6. Run: npm run dev

